APP_NAME=service-order-billing-service
APP_VERSION=3.0.0
ENVIRONMENT=production
APP_RUNTIME_MODE=real
LOG_LEVEL=INFO
LOG_JSON=true
EMAIL_PROVIDER=NOOP
CORS_ALLOWED_ORIGINS=["https://app.example.com","https://admin.example.com"]
TRUSTED_HOSTS=*

DATABASE_URL=postgresql+asyncpg://service_order_user:change-me@service-order-postgres.xxxxxx.us-east-1.rds.amazonaws.com:5432/service_order_db?ssl=require
MONGODB_URL=mongodb://service-order-mongo:27017/service_order
RABBITMQ_URL=amqp://service-order:change-me@rabbitmq.service-order.svc.cluster.local:5672/%2F
RABBITMQ_EXCHANGE=service-order.events
RABBITMQ_ROUTING_KEY=service-order.billing
RABBITMQ_QUEUE=service-order.billing.events
APP_BASE_URL=https://api.example.com
HEALTHCHECK_TIMEOUT_SECONDS=5

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=

APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_SECRET_FILE=/run/secrets/approval_token_secret
APPROVAL_TOKEN_TTL_MINUTES=60
JWT_SECRET=
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_SECRET_FILE=/run/secrets/customer_jwt_secret
CUSTOMER_JWT_ALGORITHM=HS256
CUSTOMER_JWT_ISSUER=service-order-auth-lambda/production

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_ACCESS_TOKEN_FILE=/run/secrets/mercado_pago_access_token
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_SUCCESS_URL=https://api.example.com/payments/success
MERCADO_PAGO_FAILURE_URL=https://api.example.com/payments/failure
MERCADO_PAGO_PENDING_URL=https://api.example.com/payments/pending

DD_SERVICE=service-order-billing-service
DD_ENV=production
DD_VERSION=3.0.0
DD_API_KEY=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=service-order-billing-service
OTEL_EXPORTER_OTLP_ENDPOINT=
DD_TRACE_ENABLED=false

